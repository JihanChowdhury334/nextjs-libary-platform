# Postgres connection string. A local instance needs no TLS; managed providers
# (Neon, Supabase, RDS) do, and src/db/index.ts decides based on the host.
DATABASE_URL="postgresql://user:password@localhost:5432/library"

# Signing key for the NextAuth JWT session cookie. Generate one with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=""

# The origin the app is served from.
NEXTAUTH_URL="http://localhost:3000"
